    "general_rules": [
      "信息-情绪双轨：每个镜头同时承担信息目标与情绪目标",
      "景别节奏：有目的的景别变化；同景别连用单调，收紧景别增强张力",
      "轴线一致：正反打保持180°轴线，越轴必须有动机",
      "运动有动机：推=强调，拉=揭示/疏离，跟=代入；无动机晃动是失误",
      "动静对比：静场用稳镜，动场用动镜，对比制造张力",
      "情绪放大：特写+缓推+浅景深+留白",
      "节奏分层：平均镜头时长×景别变化频率=节奏感；高潮前收紧",
      "视听统一：光色基调与情绪一致"
    ],
    "short_drama_rules": [
      "竖幅构图：人物居中偏上，脸部占比大；慎用横向宽景别",
      "全景克制：以中景/近景为主，全景仅用于定位",
      "节奏快：3-5秒一个信息点/钩子；平均镜头3-6秒，高潮1-2秒",
      "单镜头信息量：一个镜头一个重点",
      "强情绪直给：特写/大特写频率高于电影",
      "开头3秒钩子：第一镜就要抓人",
      "预留UI区：避开画面下1/4与侧边（字幕/弹窗/商品位）",
      "场景切换干净：转场利落，避免长镜头与复杂调度"
    ],
    "prompt_output_schema": {
      "per_shot_fields": [
        "镜号",
        "时长",
        "机位（摄影机位置/朝向/角度，如 门缝低机位/侧面过肩/林外高机位）",
        "站位/轴线（人物相对位置 + 180°轴线侧）",
        "景别",
        "运动（方向+速度）",
        "画面内容（主体+动作+环境）",
        "声音（人声/音效/音乐/环境）",
        "情绪基调",
        "色调/色彩（色相/明度/饱和度/冷暖）",
        "光线（主光源方向/光质/光比/色温/暗光基础，镜头间连续）",
        "剪辑/转场（剪切动机/转场类型）"
      ],
      "constraints": [
        "每镜必须写清机位（摄影机位置+朝向），禁止留空或让视频模型自行猜测",
        "一镜一义：一个镜头一个主体、一个动作、一个信息点",
        "明确主体与动作：谁+做什么+在哪",
        "明确运动：方向+速度+稳定性",
        "明确情绪：该镜头要传达的情绪",
        "可执行：描述具体到图像/视频模型可渲染，避免抽象词",
        "光线连续：每镜光线必须与场景主光源一致（如月光暗光），禁止镜头间色温/亮度跳变",
        "画面纯视觉：画面行禁止拟声词/听觉词（嘶啦/砰/响起/叫声…），声音只出现在【声音】行，避免 SD 误判",
        "物理合理：动作符合基础物理（如 织物=撕开/裂开，不用 绷断/崩断）",
        "越轴控制：轴线恒定，人物左右不互换；越轴需动机（运动/转场/心理变化），并用全景或过轴镜过渡",
        "站位锚定：双人/多人场景写明 谁在左、谁在右、面对面方向（如 A 看右、B 看左）"
      ]
