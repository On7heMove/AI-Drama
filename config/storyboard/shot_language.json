        "by_value": "按明度：亮调/暗调/灰调(同一蓝调可做成压抑暗调或明亮调子)",
        "by_saturation": "按饱和度：浓调(饱和度高/反差大/暗色多) vs 淡调(饱和度低/含灰白/强光)",
        "by_warmth": "按色性：冷调/暖调(类似题材用冷暖不同基调传达不同主题)",
        "by_psychology": "按心理：客观色调(还原真实) vs 主观色调(场景主观色/人物主观感受/情绪主观色)"
      },
      "construction": {
        "pre": "拍摄前：总体立意(黑白/彩色/交织，定写实/写意、浓/淡、冷/暖、哪个色相) + 色彩总谱(人物与环境色彩造型/重点场面色调/场面镜头间色彩转换)",
        "during": "拍摄中：选环境色彩、选季节(季节决定色调)、选光线(正面光鲜艳/逆光昏暗/直射光丰富/散射光饱和高)、选机位(面积给够/机位给到/构图突现色彩)",
        "post": "拍摄后：配光(化学/数字DI，可单独控制色相/亮度/饱和度/对比度)"
      },
      "color_attributes": "色相(本质差别)/明度(黄最高紫最低)/饱和度(混白或混黑都降饱和；红色饱和最高；互补色包围中饱和提高)",
      "contrast_harmony": "色彩对比(同时对比/明度对比/饱和度对比)与调和(相近色和谐)"
    },
    "editing_principles": {
      "murch_rule_of_six": {
        "emotion": "情感(约51%)：剪切忠实于彼时彼地的情感状态——观众最终记住的是情感",
        "story": "故事(约23%)：是否推进故事",
        "rhythm": "节奏(约10%)：是否发生在节奏有趣的'正确'时刻",
        "eye_trace": "视线(约7%)：是否照顾观众在画面上的视线焦点位置",
        "two_d": "二维平面(约5%)：是否尊重画面二维平面语法(180°轴线等)",
        "three_d": "三维空间连贯(约4%)：最低优先级；打斗/剧烈运动时可打破",
        "priority": "当多原则冲突时，优先情感与故事"
      },
      "blink_theory": "眨眼=剪切：剪切点应选在观众会'眨眼'的地方(情感/注意力转换点)；电影能接受剪切因图像并置方式与梦境相似",
      "less_is_more": "以少胜多：用最少的元素完成最多功能；暗示比明说有效；剪辑不是越多越好，大量时间花在决定'哪里不该剪'",
      "magician": "剪辑师是魔术师：用障眼法引导观众看哪里(视线引导)，但要让观众有自己选择的空间",
      "editing_types": {
        "continuity": "连续动作剪辑：在动作中剪(动作匹配)",
        "position": "画面位置剪辑",
        "balanced": "匀称剪辑",
        "conceptual": "概念剪辑：并列意念产生新含义(反转)",
        "comprehensive": "综合剪辑"
      },
      "practice_rules": [
        "新的镜头应包含新的信息",
        "每次剪辑都有理由",
        "越好的剪辑越不容易被注意",
        "反应镜头位置：对话中给听者反应",
        "兴趣点位置：保持视线焦点位置",
        "特写后接远景需有理由",
        "定场镜头准则",
        "声轨优先：对白清晰最高优先",
        "插入镜头用于突出细节",
        "空镜头/明喻镜头慎用"
      ],
      "montage_types": [
        "长度蒙太奇",
        "节奏蒙太奇",
        "音调蒙太奇",
        "协调蒙太奇",
        "理性蒙太奇(意念并置产生新含义)"
      ],
      "speed_and_genre": "不同体裁有不同速度问题(惊悚/动作冒险/音乐剧/慢速艺术片)",
      "narrative_clarity": "情节驱动 vs 人物驱动影片剪辑重点不同；戏剧性重点(特写/动态蒙太奇/并列镜头/速度)服务叙事"
    },
