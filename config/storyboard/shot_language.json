    "grammar": {
      "relation_line": "两个对话者之间有一条关系线（心理联系方向，不一定是彼此对视方向——肩并肩时横越头部）；摄影机保持在关系线同一侧（180°原则系统化）",
      "triangle_principle": "关系线一侧布置摄影机三个顶点：两个外反拍+一个内反拍；另有平行位置（正面拍）",
      "over_shoulder": {
        "exterior_reverse": "外反拍（过肩）：前景演员鼻尖不超出面颊轮廓线；1/3-2/3画面空间配置是基本方案",
        "interior_reverse": "内反拍：在关系线上只拍一个演员的近景"
      },
      "quantity_contrast": "外反拍（两演员）与内反拍（一演员）组合产生数量变化：2→2 / 2→1 / 1→1，是对话镜头序列的节奏骨架",
      "attention_center": "三人以上总有'注意力主宰者'（常是沉默者），用头部转动引导注意中心转移；沉默演员的一致视线决定谁主导",
      "pivot": "在两个反拍镜头中都出现的演员作为视觉枢轴，缓冲演员互换画面位置；枢轴演员近景可代替交代镜头",
      "deliberate_omission": "用布景障碍物遮挡某演员，制造'规则被打破'的错觉（有意的舍弃）",
      "moderator": "四人以上对话分区进行，总有一个'主持人'引导注意力；主镜头=人群全景+注意中心近景双轨",
      "editing_patterns": {
        "approach_retreat": "接近与远离：中景开场→高潮用近景/特写→回到中景休息→再进下一高潮；不同段落用不同剪辑型式以免显露手法",
        "insert_shot": "插入镜头：同视轴切入近景突出对白细节；反拍位置插入；可衔接两个主镜头（=特写同义语）",
        "cutaway": "切出镜头：对话涉及画外对象时插入对象镜头",
        "standard_coverage": "标准覆盖：主镜头（全景）贯串+分组重复整场戏+每人近景贯串→剪辑有广泛选择",
        "pause_time_compress": "顿歇打破单调；时间压缩只保留重要部分与高潮",
        "speed_up_dialogue": "静态对话速度加快约1/3（报道性对话），演员语势更响"
      },
      "scene_opening": "自然顺序：相遇→交谈→分手；先视觉上看到演员再接近听对话；段落开始或结尾几乎总有动作"
    },
    "sound_design": {
      "audiovisual_split": "声音揭示画面不能表达的：无意识意图/隐藏情绪/意外；画面讲一件事、声音讲另一件（画外世界）",
      "added_value": "音画并置产生新含义；同一声音因视觉语境不同含义不同（叹息=临终 vs 喜爱；喇叭=危险 vs 庆祝）",
      "music": {
        "empathetic": "移情音乐：强化画面情绪",
        "anempathetic": "反移情音乐：与画面无关→反讽与距离"
      },
      "auditory_hierarchy": "对白通常最高优先，其他音轨围绕它；音乐压低到对白最后一句后、于决定性节奏/情绪变化处升起；场景转换/门铃/电话可引入新环境音或音乐；戏剧高峰可撤掉音乐让噪音主导",
      "sound_arc": "同一类声音贯穿全片随情绪演变（钟表声：控制→威胁→危险→恐怖）",
      "character_music_mapping": "角色=乐器，目标=调性中心，能力=音域，情绪=音色；和声=环境/场景（情绪与空间语境），不协和=冲突（张力），节奏=节拍/场景/序列",
      "voice": "语速/语调/停顿（韵律）传达情绪；画外音可能侵入/冗余，剥夺观众自行结论的参与感",
      "soundscape": "环境氛围轨（街道/森林/室内底噪）建立空间可信度；夜晚陌生声响是恐怖升级手段",
      "post_workflow": "声音后期流程：同期声(Production Sound)→对白剪辑(Dialogue Editing)→补录对白(ADR)→拟音(Foley)→音效(SFX/Ambience)→音乐→预混→终混；对白通常最高优先，其他音轨围绕它工作"
    },
    "lighting": {
      "direction": "光的方向决定立体感与情绪：侧光塑形/逆光勾轮廓/顶光神秘/45°伦勃朗光经典",
      "quality": "硬光（小光源/远）=戏剧强对比；柔光（大光源/窗户/柔光箱）=柔顺温馨；窗户光是天然柔光",
      "ratio": "主光与填充光/环境光的比例决定反差与氛围：高光比=紧张压抑，低光比=平和",
      "background_separation": "用背景光/轮廓光把主体从背景分离（背景沦为'背景布'时视线只能放在主体上）",
      "catchlight": "低功率点缀光在眼睛里点出光点，让眼睛'活'起来",
      "mood_control": "欠曝强调昏暗（诡异/凶险）；白平衡/色温控制色调（偏蓝=冷疏离，偏暖=温情）；'照亮它的周围'而非它本身=氛围光",
      "off_axis": "离机光：光离开镜头轴线（哪怕几英寸）提升立体感与质感"
    },
    "visual_structure": {
      "contrast_affinity": "每个视觉元素(空间/线条/形状/影调/色彩/运动/节奏)都可表现对比(差异)与相似(接近)；对比=视觉强度高/动感强，相似=弱；全对比刺眼、全相似单调；故事开端用相似(低张力)、高潮用对比(高张力)",
      "depth_cues": [
