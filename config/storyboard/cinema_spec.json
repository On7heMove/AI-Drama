{
  "schema_version": "0.1",
  "pack_id": "cinema_spec",
  "description": "视频提示词摄影技术参数配置包（本地映射，确定性）：全局规格/光学/灯光/曝光/色彩五大参数族 + 剧情要素→参数映射表。输入键全部来自既有引擎输出（scene_type=SceneClassifier、scale=shot_selector 景别键、time/interior/era=ParsedScene、emotion=emotion_infer、光源词=剧本原文）；镜头/调度/构图/转场由 shot_language/shot_selector 提供，本包不重复。",
  "source": {
    "learned_at": "2026-08-20",
    "method": "联网检索专业摄影资料 + 对齐用户标准《初入江湖》第一卷字段深度",
    "basis": [
      {
        "item": "色温",
        "value": "钨丝3200K / 日光5600K / 烛光1800-2000K；真实月光≈日光，但电影常用6500-8000K冷调艺术处理",
        "source": "Practical Cinematography（专业手册）",
        "evidence": "官方手册"
      },
      {
        "item": "T值基准",
        "value": "电影摄影主流布光档 T2.8；镜头最佳成像约开大2档；不建议主镜头收至T8而特写开T2.2",
        "source": "wolfcrow《Best Aperture for Filmmaking》/ cinematography.com 从业讨论",
        "evidence": "行业经验/统计"
      },
      {
        "item": "照度",
        "value": "满月0.25lux / 客厅50 / 办公室500 / 演播室1000 / 阴天户外15000；Technicolor 时代布光 150-400fc（约1600-4300lux）",
        "source": "Amazon Lumberyard 环境照度表 / SMPE Journal",
        "evidence": "行业参考表"
      },
      {
        "item": "光比",
        "value": "1:1-2:1 柔和开放平静 / 4:1 戏剧但可读 / 8:1+ 严峻压抑；低光调高光比制造悬疑",
        "source": "光比教材（nolanx lighting continuity / 大学电影教材）",
        "evidence": "教材/行业经验"
      }
    ]
  },
