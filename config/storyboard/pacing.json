{
  "schema_version": "0.1",
  "pack_id": "scene_pacing",
  "description": "场景与情节节奏标准（v0.1）：由 场景类型 × 情绪张力 × 内容强度 决定单镜时长与镜头数。对齐 shot_language.json 与 storyboard-shot-language.md。",
  "data": {
    "principle": "张力越高 → 镜头越短越多（快切）；张力越低 → 镜头越长越少（长镜头）。",
    "shot_duration_by_scene_type": {
      "action": [1, 3],
      "dialogue": [3, 6],
      "emotion": [6, 10],
      "suspense": [4, 8],
      "reveal": [3, 6],
      "transition": [2, 4],
      "fantasy": [3, 6],
      "establishing": [4, 8]
    },
    "emotion_intensity": {
      "high": ["狂乱", "急切", "紧张", "愤怒", "恐惧", "震惊", "危机", "危险", "暴力", "崩溃", "爆发", "激烈", "疯狂"],
      "mid": ["郑重", "深沉", "坚定", "期待", "悲伤", "焦虑", "痛"],
      "low": ["压抑", "诡异", "疏离", "怀念", "温柔", "平静", "伤感", "静谧", "无力", "虚弱", "哀伤", "孤独"]
    },
    "content_intensity_high": ["撞开", "撕扯", "撕开", "尖叫", "喊", "吼", "做爱", "狂奔", "打斗", "爆炸", "追逐", "逃跑", "掐", "推倒", "砸", "猛", "急", "快", "挣脱", "疯狂"],
    "content_intensity_low": ["缓缓", "慢慢", "静", "凝望", "眺望", "沉思", "沉默", "轻", "微弱", "飘", "渐", "疏远", "空"],
    "cut_rule_high": "快切：单镜1-3s，动作中剪，打击点可升格；情绪越强镜越短、景别越近",
    "cut_rule_low": "长镜头：单镜6-10s，缓推/固定，留白；延迟揭示用 空镜→缓推→静止聚焦",
    "clamp": [1, 12]
  }
}
